Cenário 1: Adicionar uma entrega com capacidade e horas suficientes

Neste cenário, será realizada a criação de um caminhão com uma capacidade de 100 kg e 10 horas disponíveis para operação.
Em seguida, será criada uma entrega que possui um peso de 50 kg e um prazo de entrega definido.
O objetivo deste teste é verificar se o sistema permite adicionar a entrega ao caminhão,
considerando que a capacidade do caminhão é suficiente para comportar a entrega e que as horas disponíveis não serão excedidas.
Após a adição, o teste deve confirmar que o caminhão agora contém uma entrega, calcular a capacidade restante e informar o tempo utilizado para a entrega,
garantindo que os valores estejam corretos conforme as especificações.

from models.caminhao import Caminhao
from models.entrega import Entrega
from models.grafo import Grafo

def formatar_horas(horas):
    horas_inteiras = int(horas)
    minutos = int((horas - horas_inteiras) * 60)
    return f"{horas_inteiras}h {minutos}m"

if __name__ == "__main__":
    # Criando um grafo de rotas
    grafo = Grafo()
    grafo.adicionar_centro("Belém", "Cidade B", 10, 5)
    grafo.adicionar_centro("Recife", "Cidade B", 20, 34)
    grafo.adicionar_centro("São Paulo", "Cidade B", 15, 20)
    grafo.adicionar_centro("Curitiba", "Cidade B", 60, 10)

    # Criando um caminhão
    caminhao = Caminhao(capacidade=100, horas_disponiveis=10)

    # Criando uma entrega
    entrega = Entrega(destino="Cidade B", prazo="2024-12-31", peso=50)
    entrega.calcular_tempo_estimado(grafo, "Belém")

    # Adicionando a entrega ao caminhão
    caminhao.adicionar_entrega(entrega)

    print(f"Entregas no caminhão: {len(caminhao.entregas)}")
    print(f"Capacidade restante: {caminhao.capacidade_atual}")
    print(f"Horas utilizadas: {formatar_horas(caminhao.horas_utilizadas)}")

